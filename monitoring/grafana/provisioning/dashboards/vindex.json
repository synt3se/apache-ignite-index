{
  "uid": "vindex-live",
  "title": "Vector Index — Live",
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "2s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": { "refresh_intervals": ["1s", "2s", "5s", "10s", "30s", "1m"] },
  "templating": { "list": [] },

  "annotations": {
    "list": [
      {
        "name": "Demo events",
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "iconColor": "red",
        "target": { "type": "tags", "matchAny": true, "tags": ["demo"], "limit": 100 }
      }
    ]
  },

  "panels": [
    {
      "id": 1, "type": "stat", "title": "Server nodes",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "orange", "value": 2 },
          { "color": "green", "value": 4 } ] } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value", "graphMode": "area", "textMode": "auto" },
      "targets": [ { "refId": "A", "expr": "vindex_cluster_server_nodes", "legendFormat": "nodes" } ]
    },

    {
      "id": 2, "type": "gauge", "title": "Coverage",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null },
          { "color": "orange", "value": 0.8 },
          { "color": "green", "value": 0.99 } ] } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showThresholdLabels": false, "showThresholdMarkers": true },
      "targets": [ { "refId": "A", "expr": "vindex_cluster_coverage_ratio", "legendFormat": "coverage" } ]
    },

    {
      "id": 3, "type": "stat", "title": "% partial",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 0.01 },
          { "color": "red", "value": 0.2 } ] } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "area", "textMode": "auto" },
      "targets": [ { "refId": "A",
        "expr": "sum(rate(vindex_search_partial_total[1m])) / clamp_min(sum(rate(vindex_search_total[1m])), 0.001)",
        "legendFormat": "partial" } ]
    },

    {
      "id": 4, "type": "stat", "title": "Live vectors",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short",
        "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none", "graphMode": "area", "textMode": "auto" },
      "targets": [ { "refId": "A", "expr": "vindex_cluster_live_vectors", "legendFormat": "vectors" } ]
    },

    {
      "id": 5, "type": "timeseries", "title": "Coverage over time",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1.05,
        "custom": { "drawStyle": "line", "lineWidth": 3, "fillOpacity": 20,
          "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "refId": "A", "expr": "vindex_cluster_coverage_ratio", "legendFormat": "coverage" } ]
    },

    {
      "id": 6, "type": "timeseries", "title": "Search QPS",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20,
          "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(rate(vindex_search_total[1m]))", "legendFormat": "all searches" },
        { "refId": "B", "expr": "sum(rate(vindex_search_partial_total[1m]))", "legendFormat": "partial" }
      ]
    },

    {
      "id": 7, "type": "timeseries", "title": "Search latency (HTTP)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0,
          "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{uri=~\"/vectors/search.*\"}[1m])) by (le))", "legendFormat": "p50" },
        { "refId": "B", "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=~\"/vectors/search.*\"}[1m])) by (le))", "legendFormat": "p95" },
        { "refId": "C", "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=~\"/vectors/search.*\"}[1m])) by (le))", "legendFormat": "p99" }
      ]
    },

    {
      "id": 8, "type": "timeseries", "title": "Live vectors per node (stacked)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 1, "fillOpacity": 60,
          "showPoints": "never", "spanNulls": true,
          "stacking": { "mode": "normal", "group": "A" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "vindex_node_live_vectors", "legendFormat": "{{node}}" } ]
    },

    {
      "id": 9, "type": "timeseries", "title": "Partitions per node: active / owned",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0,
          "showPoints": "never", "spanNulls": true } },
        "overrides": [ { "matcher": { "id": "byRegexp", "options": "owned.*" },
          "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "vindex_node_active_partitions", "legendFormat": "active {{node}}" },
        { "refId": "B", "expr": "vindex_node_owned_partitions", "legendFormat": "owned {{node}}" }
      ]
    },

    {
      "id": 10, "type": "timeseries", "title": "Index lag: backlog · dirty · engine pending",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10,
          "showPoints": "never", "spanNulls": true } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "sum(vindex_node_applier_backlog)", "legendFormat": "applier backlog" },
        { "refId": "B", "expr": "sum(vindex_node_dirty_partitions)", "legendFormat": "dirty partitions" },
        { "refId": "C", "expr": "sum(vindex_node_engine_pending)", "legendFormat": "engine pending" }
      ]
    },

    {
      "id": 11, "type": "timeseries", "title": "Heap used per node",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10,
          "showPoints": "never", "spanNulls": true } },
        "overrides": [ { "matcher": { "id": "byRegexp", "options": "max.*" },
          "properties": [ { "id": "custom.lineStyle", "value": { "fill": "dash", "dash": [8, 4] } } ] } ] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "refId": "A", "expr": "vindex_node_heap_used_bytes", "legendFormat": "used {{node}}" },
        { "refId": "B", "expr": "vindex_node_heap_max_bytes", "legendFormat": "max {{node}}" }
      ]
    },

    {
      "id": 12, "type": "timeseries", "title": "Node uptime",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0,
        "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0,
          "showPoints": "never", "spanNulls": false } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [ { "refId": "A", "expr": "vindex_node_uptime_ms / 1000", "legendFormat": "{{node}}" } ]
    },

    {
      "id": 13, "type": "stat", "title": "Cluster reachable",
      "gridPos": { "h": 6, "w": 4, "x": 8, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short",
        "mappings": [
          { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
          { "type": "value", "options": { "1": { "text": "OK", "color": "green", "index": 1 } } } ],
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } }, "overrides": [] },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background", "graphMode": "none", "textMode": "auto" },
      "targets": [ { "refId": "A", "expr": "vindex_cluster_reachable", "legendFormat": "reachable" } ]
    },

    {
      "id": 14, "type": "timeseries", "title": "% partial over time",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 27 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1,
        "custom": { "drawStyle": "line", "lineWidth": 3, "fillOpacity": 30,
          "showPoints": "never", "spanNulls": true,
          "thresholdsStyle": { "mode": "dashed" } },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 0.01 },
          { "color": "red", "value": 0.2 } ] } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": false },
        "tooltip": { "mode": "single", "sort": "none" } },
      "targets": [ { "refId": "A",
        "expr": "sum(rate(vindex_search_partial_total[1m])) / clamp_min(sum(rate(vindex_search_total[1m])), 0.001)",
        "legendFormat": "partial" } ]
    }
  ]
}